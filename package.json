{
  "name": "hurcane-react",
  "version": "0.2.4",
  "description": "React components for embedding Hurcane AI agents",
  "author": "Hurcane",
  "license": "MIT",
  "homepage": "https://hurcane.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/hurcane/hurcane-react"
  },
  "keywords": [
    "hurcane",
    "ai",
    "agent",
    "chatbot",
    "react",
    "widget"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
